// ─── GET PAYMENT BY ID (FIXED) ─────────────────────────────
exports.getPaymentById = async (req, res) => {
  try {
    const { hostId } = req.query;
    const { id } = req.params;

    // ✅ Prevent crash
    if (!mongoose.Types.ObjectId.isValid(id)) {
      return res.status(400).json({
        success: false,
        message: "Invalid Payment ID",
      });
    }

    const payment = await Payment.findOne({
      _id: id,
      host: hostId,
    }).select("-receiptImage -rawOcrText");

    if (!payment) {
      return res.status(404).json({
        success: false,
        message: "Payment not found.",
      });
    }

    res.json({
      success: true,
      payment,
    });

  } catch (err) {
    console.error("getPaymentById error:", err);
    res.status(500).json({
      success: false,
      message: "Server error.",
      error: err.message,
    });
  }
};

// ─── CANCEL PAYMENT ────────────────────────────────────────
exports.cancelPayment = async (req, res) => {
  try {
    const payment = await Payment.findByIdAndUpdate(
      req.params.id,
      { $set: { status: "cancelled" } },
      { new: true }
    );
    if (!payment) return res.status(404).json({ success: false, message: "Payment not found." });
    res.json({ success: true, message: "Payment cancelled.", payment });
  } catch (err) {
    res.status(500).json({ success: false, message: "Server error.", error: err.message });
  }
};

// ─── GET RECEIPT IMAGE ─────────────────────────────────────
exports.getReceiptImage = async (req, res) => {
  try {
    const payment = await Payment.findById(req.params.id)
      .select("receiptImage receiptMimeType");

    if (!payment || !payment.receiptImage) {
      return res.status(404).json({ success: false, message: "Receipt image not found." });
    }

    // Convert MongoDB buffer to proper Buffer
    const imageBuffer = Buffer.isBuffer(payment.receiptImage)
      ? payment.receiptImage
      : Buffer.from(payment.receiptImage.buffer ?? payment.receiptImage);

    res.set("Content-Type", payment.receiptMimeType || "image/png");
    res.set("Content-Length", imageBuffer.length);
    res.set("Cache-Control", "no-store");
    res.end(imageBuffer);

  } catch (err) {
    console.error("getReceiptImage error:", err);
    res.status(500).json({ success: false, message: "Server error.", error: err.message });
  }
};

// ─── UPLOAD RECEIPT ────────────────────────────────────────
exports.uploadReceipt = async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ success: false, message: "No file uploaded." });
    }
    await Payment.findByIdAndUpdate(req.params.id, {
      $set: {
        receiptImage:      req.file.buffer,
        receiptMimeType:   req.file.mimetype,  // ← saves mime type
        receiptUploadedAt: new Date(),
        status:            "pending",
      }
    });
    res.json({ success: true, message: "Receipt uploaded successfully." });
  } catch (err) {
    res.status(500).json({ success: false, message: "Server error.", error: err.message });
  }
};

